// Rule name:      Brute force - repeated failed logons from a single source IP
// Detects:        10 or more failed Windows logons (Event ID 4625) from one source IP
//                 against one host within 10 minutes, typical of RDP/SMB password guessing.
// Data source:    SecurityEvent via Windows Security Events (AMA) data collection rule
// MITRE ATT&CK:   Credential Access / T1110.001 Brute Force: Password Guessing
// Severity:       Medium
// Schedule:       runs every 10 min, looks back 10 min
// Threshold:      generate alert when results > 0
// Entity mapping: Host = Computer, IP = IpAddress (Account not mapped: TargetedAccounts is a set)
// Tested:         2026-10-24 - Logs: 18 failed RDP logons from one IP, 1 row. Scheduled rule: 14 failures in 33 s, alert after 8 min, incident #1 (INC-001)
// Tuning notes:   RDP with NLA logs failures as LogonType 3, not 10, so the rule does not filter by LogonType.
//                 TargetAccount already includes the domain in SecurityEvent; do not prepend TargetDomainName.

SecurityEvent
| where TimeGenerated > ago(10m)
| where EventID == 4625
| where IpAddress != "-" and isnotempty(IpAddress)
| summarize
    FailedAttempts = count(),
    TargetedAccounts = make_set(TargetAccount, 20),
    FirstAttempt = min(TimeGenerated),
    LastAttempt = max(TimeGenerated)
    by IpAddress, Computer
| where FailedAttempts >= 10
| project FirstAttempt, LastAttempt, Computer, IpAddress, FailedAttempts, TargetedAccounts
